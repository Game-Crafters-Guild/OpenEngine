<UIElement class="sceneview-panel">
  <SceneViewToolbar id="SceneViewToolbar" class="sceneview-toolbar">
    <CameraBookmarksWidget id="CameraBookmarks"/>
    <UIElement class="toolbar-spacer" />
    <!-- Inline tool mode buttons (visible when overlay is hidden) -->
    <UIElement id="InlineToolButtons" class="sceneview-toolbar-buttons inline-tool-buttons hidden">
      <Button id="InlineSelectBtn" class="scene-tool-btn select-tool-icon icon-active" />
      <Button id="InlineTranslateBtn" class="scene-tool-btn translate-tool-icon" />
      <Button id="InlineRotateBtn" class="scene-tool-btn rotate-tool-icon" />
      <Button id="InlineScaleBtn" class="scene-tool-btn scale-tool-icon" />
      <Button id="InlineMeasureBtn" class="scene-tool-btn ruler-tool-icon" />
    </UIElement>
    <UIElement class="sceneview-toolbar-buttons sceneview-toolbar-right">
      <SceneViewLayersField id="SceneViewLayersFilter" />
      <Button id="ToolbarSpacer1" class="toolbar-spacer-btn" />
      <Button id="CameraSettingsBtn" class="small secondary icon-button camera-settings-icon" />
      <Button id="GridToggle" class="small secondary icon-button grid-icon" />
      <Button id="SnapToggle" class="small secondary icon-button snap-icon" />
      <Button id="GizmoToggle" class="small secondary icon-button gizmo-icon" />
      <Button id="PickModeToggle" class="small secondary icon-button pick-mode-icon" />
      <Button id="ToolSpaceToggle" class="small secondary icon-button transform-space-icon" />
      <Button id="View2DToggle" class="small secondary icon-button view2d-icon" />
      <Button id="ProjectionToggle" class="small secondary icon-button projection-icon" />
      <Button id="QuadViewToggle" class="small secondary icon-button quad-view-icon" />
      <Button id="PostProcessToggle" class="small secondary icon-button post-process-icon icon-active" />
      <Button id="RotationGizmoToggle" class="small secondary icon-button nav-gizmo-icon icon-active" />
      <Button id="ToolOverlayToggle" class="small secondary icon-button tool-overlay-icon icon-active" />
    </UIElement>
  </SceneViewToolbar>

  <UIElement id="SceneViewViewportHost" class="scene-viewport-host">
    <!-- The perspective pane shows the main scene image: engine("scene_main") in theme/scene-view.css -->
    <SceneViewport id="SceneViewViewport" slot="perspective" class="scene-viewport scene-viewport-slot scene-viewport-perspective active-viewport">
      <!-- Floating tool overlay: left edge of the viewport, centered on its height; slides up to keep one inset above the FPS label, pins at the top inset when it cannot -->
      <SceneViewToolOverlay id="SceneToolOverlay" class="scene-tool-overlay">
        <Button id="SelectModeBtn" class="scene-tool-btn select-tool-icon" />
        <Button id="TranslateModeBtn" class="scene-tool-btn translate-tool-icon icon-active" />
        <Button id="RotateModeBtn" class="scene-tool-btn rotate-tool-icon" />
        <Button id="ScaleModeBtn" class="scene-tool-btn scale-tool-icon" />
        <Button id="MeasureToolBtn" class="scene-tool-btn ruler-tool-icon" />
      </SceneViewToolOverlay>
    </SceneViewport>
    <SceneViewport id="SceneViewViewportTop" slot="top" class="scene-viewport scene-viewport-slot hidden" />
    <SceneViewport id="SceneViewViewportFront" slot="front" class="scene-viewport scene-viewport-slot hidden" />
    <SceneViewport id="SceneViewViewportSide" slot="side" class="scene-viewport scene-viewport-slot hidden" />
    <UIElement id="SceneViewQuadSplitVerticalTop" class="scene-quad-split-handle scene-quad-split-vertical hidden">
      <UIElement id="SceneViewQuadSplitVerticalTopLine" class="scene-quad-split-line scene-quad-split-line-vertical" />
    </UIElement>
    <UIElement id="SceneViewQuadSplitVerticalBottom" class="scene-quad-split-handle scene-quad-split-vertical hidden">
      <UIElement id="SceneViewQuadSplitVerticalBottomLine" class="scene-quad-split-line scene-quad-split-line-vertical" />
    </UIElement>
    <UIElement id="SceneViewQuadSplitHorizontal" class="scene-quad-split-handle scene-quad-split-horizontal hidden">
      <UIElement id="SceneViewQuadSplitHorizontalLine" class="scene-quad-split-line scene-quad-split-line-horizontal" />
    </UIElement>
  </UIElement>
</UIElement>
