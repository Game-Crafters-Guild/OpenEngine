[entity id="post_process_volume"]
; The default height fog: a horizon haze in the sky's own horizon color at every time of day. From the
; default camera it starts 150 m out and is dense only in the last few degrees above the horizon. The
; ground reaches 3000 m from the origin, the Main Camera's far clip and the fog's maxDistance, so by
; day the end of the ground does not show; at night it reads as a faint line where the ground ends.
HeightFogEffect.enabled = true
HierarchyOrder.order = 40
Name.value = "Post Process Volume"
PostProcessVolume.enabled = true
PostProcessVolume.isGlobal = true
Transform.position = (0, 0, 0)
Transform.rotation = (0, 0, 0, 1)
Transform.scale = (1, 1, 1)

