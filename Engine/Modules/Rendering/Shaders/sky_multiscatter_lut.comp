#version 450

// Hillaire 2020 multiple-scattering LUT.
// Keyed by the sun's zenith cosine and the normalised height, with the half-texel inset
// (Includes/sky_multiscatter_lut.glsl).
// Each texel integrates second-order scattered light (L2) and the multiscatter
// feedback fraction (fms) over the full sphere of incoming directions, then sums
// the geometric series Psi_ms = L2 / (1 - fms) to get the infinite-bounce factor.
//
// Physical inputs (densities, beta coefficients, scale heights, transmittance
// LUT parameterization) are kept verbatim with sky_view_lut.comp so the
// multiscatter term stays consistent with the single-scatter march that consumes
// it. The sun illuminance is normalized to white (1,1,1) here; the sky-view
// march applies the real sun color/intensity when it samples this LUT.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D oMultiscatterLUT;

layout(set = 0, binding = 1) uniform sampler2D uTransmittanceLUT;

#include "Includes/sky_atmosphere_ubo.glsl"
#include "Includes/sky_multiscatter_lut.glsl"

const float PI = 3.14159265359;
const float kInvFourPi = 1.0 / (4.0 * PI);

// Sphere-direction sampling grid. 8 azimuth x 8 zenith = 64 directions.
const int kSqrtSamples = 8;
const int kNumDirections = kSqrtSamples * kSqrtSamples;

// Ray-march step count along each sphere direction. Lower than the sky-view
// march (64) because this is an N-direction inner loop; 32 keeps the LUT cheap
// while staying smooth (Hillaire uses ~20-40 here).
const int kNumSteps = 32;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(oMultiscatterLUT);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    // The sun's zenith cosine and the normalised height this texel centre stands for
    // (Includes/sky_multiscatter_lut.glsl).
    vec2 params = GE_SkyMultiscatterLutParams((vec2(pixel) + 0.5) / vec2(size), vec2(size));
    float sunCosZenith = params.x;
    float heightNorm = params.y;

    // Sample point on the planet 'up' axis at the requested altitude. The frame
    // is built so 'up' = +Y; the sun direction is reconstructed purely from
    // sunCosZenith (azimuth is irrelevant for an isotropic multiscatter LUT).
    float atmoThickness = uAtmos.atmosphereRadius - uAtmos.planetRadius;
    float radius = uAtmos.planetRadius + heightNorm * atmoThickness;
    vec3 planetCenter = vec3(0.0);
    vec3 up = vec3(0.0, 1.0, 0.0);
    vec3 samplePos = planetCenter + up * radius;

    float sinTheta = sqrt(max(0.0, 1.0 - sunCosZenith * sunCosZenith));
    vec3 sunDir = normalize(vec3(sinTheta, sunCosZenith, 0.0));

    // Accumulate over the full sphere of incoming directions.
    vec3 L2 = vec3(0.0);   // second-order scattered radiance (sun-lit)
    vec3 fms = vec3(0.0);  // multiscatter feedback fraction (uniform ambient = 1)

    for (int iAz = 0; iAz < kSqrtSamples; ++iAz)
    {
        for (int iZen = 0; iZen < kSqrtSamples; ++iZen)
        {
            // Uniform-area sphere sampling: cosZenith uniform in [-1,1],
            // azimuth uniform in [0, 2PI). Each cell has equal solid angle, so
            // the per-direction weight is exactly 4*PI / N.
            float u0 = (float(iAz) + 0.5) / float(kSqrtSamples);
            float u1 = (float(iZen) + 0.5) / float(kSqrtSamples);
            float cosZ = u1 * 2.0 - 1.0;
            float sinZ = sqrt(max(0.0, 1.0 - cosZ * cosZ));
            float phi = u0 * 2.0 * PI;
            vec3 omega = vec3(sinZ * cos(phi), cosZ, sinZ * sin(phi));

            // March the atmosphere from samplePos along omega.
            float t0, t1;
            if (!GE_RaySphereIntersect(samplePos, omega, planetCenter, uAtmos.atmosphereRadius, t0, t1))
                continue;

            float tStart = max(0.0, t0);
            float tEnd = t1;

            // Clip the march to the ground if the ray hits the planet: a downward ray that
            // meets the sphere ahead. The lowest row's sample sits on the ground, where a
            // downward ray meets it at once (t = 0).
            float tg0, tg1;
            bool hitsGround = false;
            if (omega.y < 0.0 &&
                GE_RaySphereIntersect(samplePos, omega, planetCenter, uAtmos.planetRadius, tg0, tg1) &&
                tg1 > 0.0)
            {
                tEnd = min(tEnd, max(tg0, 0.0));
                hitsGround = true;
            }

            float dt = max(tEnd - tStart, 0.0) / float(kNumSteps);
            float t = tStart + 0.5 * dt;

            vec3 pathTransmittance = vec3(1.0);

            for (int i = 0; i < kNumSteps; ++i)
            {
                vec3 p = samplePos + omega * t;
                float r = length(p - planetCenter);
                float h = r - uAtmos.planetRadius;
                if (h < 0.0) break;

                GE_SkyMedium medium = GE_SkyMediumAt(h);
                vec3 sigmaS = medium.scatterRayleigh + medium.scatterMie;
                vec3 sigmaE = medium.extinction;

                vec3 stepTransmittance = exp(-sigmaE * dt);

                // Transmittance from this sample point toward the sun, 0 where the planet
                // is in the way (the planet's shadow).
                vec3 upP = (p - planetCenter) / r;
                float sunZenith = dot(upP, sunDir);
                vec3 transToSun = GE_SkyTransmittanceToTop(uTransmittanceLUT, r, sunZenith,
                                                           uAtmos.planetRadius, uAtmos.atmosphereRadius);

                // Energy-conserving analytic integral of in-scattered light over
                // the step: integral(sigmaS * T(s)) ds = sigmaS * (1 - stepT) / sigmaE.
                // (sigmaS / sigmaE) is the single-scatter albedo of the step.
                vec3 stepIntegral = (sigmaS - sigmaS * stepTransmittance) / max(sigmaE, vec3(1e-9));

                // L2: second-order luminance along omega. The incoming light is the
                // sun illuminance (white) * transmittance-to-sun, scattered toward the
                // sample point with the isotropic phase 1/(4 pi) (Hillaire 2020 uses a
                // uniform phase for this LUT).
                L2 += pathTransmittance * stepIntegral * transToSun * kInvFourPi;

                // fms: the transfer of a uniform unit radiance along omega, with no
                // phase yet: the fraction of light that scatters back toward the
                // sample point, per unit incoming radiance, once integrated below.
                fms += pathTransmittance * stepIntegral;

                pathTransmittance *= stepTransmittance;

                t += dt;
            }

            // The ground's bounce (Hillaire 2020, NewMultiScatCS): a ray that ends on the
            // planet receives the sunlight the ground reflects back up it, Lambertian at the
            // floor's albedo, through the path's transmittance. It is radiance arriving along
            // omega, so it takes no phase here; the sphere integral below scatters it.
            if (hitsGround)
            {
                vec3 groundPos = samplePos + omega * tEnd;
                vec3 groundUp = normalize(groundPos - planetCenter);
                float groundSunCos = dot(groundUp, sunDir);
                vec3 groundTransToSun = GE_SkyTransmittanceToTop(uTransmittanceLUT, uAtmos.planetRadius,
                                                                 groundSunCos, uAtmos.planetRadius,
                                                                 uAtmos.atmosphereRadius);
                L2 += pathTransmittance * groundTransToSun * max(groundSunCos, 0.0) * uAtmos.groundAlbedo / PI;
            }
        }
    }

    // Hillaire 2020, eqs. 7 and 8: both sphere integrals are taken with the
    // uniform-area weight dOmega = 4 pi / N and then multiplied by the
    // isotropic phase 1/(4 pi) once more, because the luminance they give
    // arrives at the sample point from every direction and is re-scattered
    // there isotropically (NewMultiScatCS: `* SphereSolidAngle / N`, then
    // `* IsotropicPhase` on both). For fms the per-direction sum carries no
    // phase, so the two factors reduce it to the mean over the sphere; L2 keeps
    // its in-march phase and gains the second one.
    float dOmega = 4.0 * PI / float(kNumDirections);
    L2 *= dOmega * kInvFourPi;
    fms *= dOmega * kInvFourPi;

    // Infinite multiple-scattering geometric series: sum_{n>=0} fms^n * L2.
    // Clamp fms < 1 so the sum stays finite (single-scatter albedo < 1 already
    // guarantees this physically; the clamp guards numerical edge cases).
    vec3 clampedFms = clamp(fms, vec3(0.0), vec3(0.9999));
    vec3 psiMs = L2 / (vec3(1.0) - clampedFms);

    // Absolute scene-linear, never pre-exposed (P = 1 by construction): the passes that sample
    // this LUT into scene colour apply the pre-exposure themselves.
    imageStore(oMultiscatterLUT, pixel, vec4(psiMs, 1.0));
}
