#version 450

// Tier 1 atmosphere: simple transmittance LUT
// Dimensions: 256 x 64, written as rgba16f

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) writeonly uniform image2D uTransLUT;

// Very simple atmosphere model inspired by Hillaire-style setups.
// Parameters are now driven by a shared AtmosphereUBO so CPU and shaders
// see the same configuration.

#define GE_ATMOSPHERE_UBO_BINDING 1
#include "Includes/sky_atmosphere_ubo.glsl"
#include "Includes/sky_transmittance_lut.glsl"

void main()
{
    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(uTransLUT);
    if (pix.x >= size.x || pix.y >= size.y)
        return;

    // The (r, mu) this texel centre stands for, over the rays that leave the atmosphere without
    // meeting the planet (Includes/sky_transmittance_lut.glsl).
    vec2 uv = (vec2(pix) + 0.5) / vec2(size);
    vec2 rMu = GE_SkyTransmittanceLutUvToRMu(uv, uAtmos.planetRadius, uAtmos.atmosphereRadius, vec2(size));
    float r  = rMu.x;
    float mu = rMu.y;

    // Optical depth to the top of the atmosphere, midpoint rule.
    float sMax = GE_DistanceToOuterSphere(r, mu, uAtmos.atmosphereRadius);
    if (sMax <= 0.0)
    {
        imageStore(uTransLUT, pix, vec4(1.0));
        return;
    }

    // Midpoint rule with steps short against the aerosol's 1.2 km scale height. The error grows with
    // the aerosol's density: from the ground at 10 degrees, 40 steps miss the transmittance by 0.8 %
    // at Earth's pristine aerosol (optical depth 0.005) and by 16 % at a hazy day's 0.20; 512 steps
    // keep a typical day's (0.15) within 0.1 % of the converged integral down to the horizon. The
    // LUT is baked only when the atmosphere changes.
    const int kSteps = 512;
    float ds = sMax / float(kSteps);

    vec3 tau = vec3(0.0);
    for (int i = 0; i < kSteps; ++i)
    {
        float sm = (float(i) + 0.5) * ds;

        float r2 = r * r + sm * sm + 2.0 * r * mu * sm;
        float rSample = sqrt(max(r2, 0.0));
        float hSample = max(0.0, rSample - uAtmos.planetRadius);

        tau += GE_SkyMediumAt(hSample).extinction * ds;
    }

    // True optical transmittance exp(-tau) of the full extinction (Rayleigh, Mie scattering and
    // absorption, ozone), no tint or floor: this LUT is the sun-shadow term of
    // the sky-view and multiscatter marches, the sun disc's and the glare's extinction and the
    // PlanetGround floor's sun term, so it has to stay physical. Rays that meet the planet are not
    // stored; GE_SkyTransmittanceToTop returns 0 for them.
    //
    // Nothing here is shared with the CPU mirror (AtmosphereTransmittance.cpp), which evaluates
    // the same optical depth at the planet surface for the ground consumers (the directional
    // light and the fog) and takes the chord through the planet below the horizon. uSky.sunColor
    // is neither: it is the untouched above-atmosphere tint (SkyEnvironmentSystem.cpp
    // primarySunColor), which is what makes this LUT the sky's only extinction.
    vec3 transmittance = exp(-tau);
    // A ratio, independent of the pre-exposure.
    imageStore(uTransLUT, pix, vec4(transmittance, 1.0));
}
