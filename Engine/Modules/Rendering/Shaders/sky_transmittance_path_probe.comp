#version 450

// Test-only probe for the transmittance LUT's (r, mu) mapping and its path length
// (SkyTransmittanceLutParityTests).
//
// It exists because the property it checks cannot be reached from the CPU or from the LUT's own
// output. The hazard is float32 cancellation at planet scale, in the ray-sphere solve and in the
// mapping's differences of squares, plus the compiler's licence to contract one of two squares
// into an FMA -- and the compiler in question is the DRIVER's (MoltenVK hands SPIR-V to Metal,
// which recompiles it). A CPU simulation of the arithmetic is not the arithmetic that ships.
//
// The LUT's own texels cannot see it either: it stores exp(-tau) in rgba16f, and near the surface a
// 5% error in the path length moves a transmittance of ~1 by less than one fp16 ULP. The path
// length is the quantity that carries the defect, so the probe reports it directly.

#include "Includes/sky_transmittance_lut.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer ProbeOut { vec4 result[]; } uOut;

layout(push_constant) uniform ProbePC
{
    // x planet radius, y atmosphere radius, z LUT row, w LUT rows
    vec4 radiiAndRow;
    // x LUT columns (one invocation per column)
    vec4 columns;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    float columns = pc.columns.x;
    if (float(i) >= columns)
        return;

    // The (r, mu) the LUT texel (i, row) bakes, exactly as sky_transmittance_lut.comp decodes it.
    vec2 lutSize = vec2(columns, pc.radiiAndRow.w);
    vec2 uv = (vec2(float(i), pc.radiiAndRow.z) + 0.5) / lutSize;
    vec2 rMu = GE_SkyTransmittanceLutUvToRMu(uv, pc.radiiAndRow.x, pc.radiiAndRow.y, lutSize);

    float sAtmosphere = GE_DistanceToOuterSphere(rMu.x, rMu.y, pc.radiiAndRow.y);
    // The forward mapping of the decoded pair: a reader asking for this (r, mu) lands on this texel.
    vec2 uvBack = GE_SkyTransmittanceLutRMuToUv(rMu.x, rMu.y, pc.radiiAndRow.x, pc.radiiAndRow.y, lutSize);

    uOut.result[i] = vec4(sAtmosphere, uvBack.x - uv.x, rMu.y, rMu.x);
}
