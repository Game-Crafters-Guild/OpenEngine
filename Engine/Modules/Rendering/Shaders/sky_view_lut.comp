#version 450

#include "Includes/moon_disc.glsl"
#include "Includes/sky_composite.glsl"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Absolute radiance from a noon sky down to a moonless night (8e-7): binary32, as
// SkyRenderer::SkyViewLutFormat creates it. The compat (WebGPU) kernel keeps binary16, whose
// 32-bit float filtering is an optional feature there.
#if defined(GE_COMPAT_PROFILE)
layout(set = 0, binding = 0, rgba16f) uniform writeonly image2D oSkyViewLUT;
#else
layout(set = 0, binding = 0, rgba32f) uniform writeonly image2D oSkyViewLUT;
#endif

layout(set = 0, binding = 1) uniform sampler2D uTransmittanceLUT;

#include "Includes/sky_atmosphere_ubo.glsl"
#include "Includes/sky_transmittance_lut.glsl"
#include "Includes/sky_multiscatter_lut.glsl"

layout(set = 0, binding = 4) uniform sampler2D uMultiscatterLUT;

layout(set = 0, binding = 3) uniform SkyUBO
{
    vec3  cameraPositionWS;   float exposureEV;
    vec3  cameraRightWS;      float pad0;
    vec3  cameraUpWS;         float pad1;
    vec3  cameraForwardWS;    float pad2;
    vec3  sunDirectionWS;     float sunAngularRadius;
    vec3  moonDirectionWS;    float moonIntensity;
    float moonAngularRadius;
    float skyRotateAroundZenithRadians;
    float moonUboPad1;
    float moonUboPad2;
    vec3  sunColor;           float sunIntensity;
    float timeOfDayHours;     float skyPad0;
    float viewportAspect;     float tanHalfFovY;
    vec2  viewportResolution; float nightSkyBlend; float skyTimeSeconds;
    vec4  starModel;    // x = limiting magnitude, y = highlight compression, z = scintillation, w = twinkle speed
    vec4  skyboxParams; // x = HDRI rotation radians; y = HDRI intensity if >= 0, else the procedural sky
} uSky;

const float PI = 3.14159265359;

// A source's in-scatter at a march sample, per unit length: single scattering with the source's
// transmittance to the top of the atmosphere (0 in the planet's shadow) and the aerosol and Rayleigh
// phases, plus Hillaire's multiple scattering, whose LUT is per unit white source and keyed by the
// source's zenith, so the sun and the moon read the same LUT.
vec3 SourceInScatter(vec3 rayDir, vec3 upP, float r, float h, vec3 sigmaS_Ray, vec3 sigmaS_Mie,
                     vec3 srcDir, vec3 srcRadiance)
{
    float srcZenith = dot(upP, srcDir);
    vec3 transToSrc = GE_SkyTransmittanceToTop(uTransmittanceLUT, r, srcZenith,
                                               uAtmos.planetRadius, uAtmos.atmosphereRadius);
    float mu = dot(rayDir, srcDir);
    float phaseRay = 3.0 / (16.0 * PI) * (1.0 + mu * mu);
    float phaseMie = GE_SkyAerosolPhase(mu);
    vec3 single = (sigmaS_Ray * phaseRay + sigmaS_Mie * phaseMie) * transToSrc;
    vec2 msSize = vec2(textureSize(uMultiscatterLUT, 0));
    vec3 msSample = textureLod(uMultiscatterLUT,
        GE_SkyMultiscatterLutUv(srcZenith, h / (uAtmos.atmosphereRadius - uAtmos.planetRadius), msSize),
        0.0).rgb;
    return (single + (sigmaS_Ray + sigmaS_Mie) * msSample) * srcRadiance;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(oSkyViewLUT);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    vec3 sunDir = normalize(uSky.sunDirectionWS);
    vec3 moonDir = normalize(uSky.moonDirectionWS);
    vec3 planetCenter = vec3(0.0, -uAtmos.planetRadius, 0.0);
    vec3 camPos = uSky.cameraPositionWS;
    float camHeight = length(camPos - planetCenter);
    vec3 up = (camPos - planetCenter) / camHeight;

    // Two sources, each only while it can matter (uniform across the dispatch): the sun until it is
    // 20 degrees under, where the planet's shadow has taken its in-scatter below the night sky's own
    // glow; the moon while it is up to 20 degrees under and the sun is below 10 degrees, above which
    // the sun outshines it by a million. So a day or a deep-night bake runs one source and only the
    // twilight band, with both bodies near the horizon, runs two.
    const float kSourceFloorUp = -0.342;  // sin(-20 degrees)
    const float kMoonSunCeilingUp = 0.174; // sin(10 degrees)
    bool sunActive = uSky.sunIntensity > 0.0 && dot(sunDir, up) > kSourceFloorUp;
    bool moonActive = uSky.moonIntensity > 0.0 && dot(moonDir, up) > kSourceFloorUp &&
                      dot(sunDir, up) < kMoonSunCeilingUp;
    vec3 sunRadiance = uSky.sunColor * uSky.sunIntensity;
    vec3 moonRadiance = GE_MOON_TINT * uSky.moonIntensity;

    // Azimuth/elevation directions in the camera/planet-local horizon frame
    // (same mapping the render + capture passes encode with). No polar
    // singularity in the horizon band where it matters.
    vec3 northRef = vec3(0.0, 0.0, 1.0);
    if (abs(dot(northRef, up)) > 0.98)
        northRef = vec3(1.0, 0.0, 0.0);
    vec3 east = normalize(cross(up, northRef));
    vec3 north = normalize(cross(east, up));

    vec3 local = GE_SkyViewLutUvToDir(uv);

    // Below-horizon mode (0 = ContinueHorizon, 1 = PlanetGround, 2 = StylizedGround).
    // ContinueHorizon folds below-horizon texels up to the grazing horizon so they
    // store the horizon atmosphere color — the gradient continues down with no black
    // band and no seam. Renormalize after raising y so rayDir stays a unit direction.
    const uint kBelowHorizonContinue = 0u;
    const uint kBelowHorizonPlanetGround = 1u;
    // Fold a thin band on BOTH sides of the horizon up to the same grazing direction,
    // not just the decoded-below-horizon texels. The rows just above the horizon would
    // otherwise march the full grazing path, whose transmittance collapses to a dark
    // navy notch; clamping them to the grazing floor keeps the horizon monotonic and
    // seamless (the notch was widened into a visible band by the elevation warp).
    // PlanetGround folds the same way: the LUT stores pure aerial-perspective haze
    // below the horizon, and the lit floor is composited per-pixel in the render pass.
    // The horizon is the planet's: level for a camera on the ground, dipping below the
    // horizontal as the camera climbs (10 degrees at 100 km), with the sky down to it.
    float horizonSin = -sqrt(max(0.0, 1.0 - (uAtmos.planetRadius / camHeight) * (uAtmos.planetRadius / camHeight)));
    float foldSin = horizonSin + 0.002;
    if ((uAtmos.belowHorizonMode == kBelowHorizonContinue ||
         uAtmos.belowHorizonMode == kBelowHorizonPlanetGround) && local.y < foldSin)
    {
        // Keep the texel's azimuth and raise it to the fold's elevation. (Setting y and
        // renormalising would turn the texels near the nadir, whose horizontal part is
        // tiny, toward the zenith or, at altitude, the nadir.)
        vec2 azimuth = length(local.xz) > 1e-6 ? normalize(local.xz) : vec2(1.0, 0.0);
        float foldCos = sqrt(1.0 - foldSin * foldSin);
        local = vec3(azimuth.x * foldCos, foldSin, azimuth.y * foldCos);
    }

    vec3 rayDir = normalize(local.x * east + local.y * up + local.z * north);

    float t0, t1;
    if (!GE_RaySphereIntersect(camPos, rayDir, planetCenter, uAtmos.atmosphereRadius, t0, t1))
    {
        imageStore(oSkyViewLUT, pixel, vec4(0.0));
        return;
    }

    float tStart = max(0.0, t0);
    float tEnd = t1;

    // Terminate the march at the planet surface for grazing rays that clip the sphere.
    float tg0, tg1;
    if (GE_RaySphereIntersect(camPos, rayDir, planetCenter, uAtmos.planetRadius, tg0, tg1) && tg0 > 0.0)
    {
        tEnd = min(tEnd, tg0);
    }

    // Steps grow quadratically along the ray (Hillaire 2020's variable sample distribution): short
    // where the ray leaves the camera through the dense aerosol near the ground, long in the thin air
    // above. Even steps put a low ray's whole first kilometres of haze into one step.
    const int kNumSteps = 64;
    float span = tEnd - tStart;

    vec3 accumScattering = vec3(0.0);
    vec3 accumTransmittance = vec3(1.0);
    
    for (int i = 0; i < kNumSteps; i++)
    {
        float u0 = float(i) / float(kNumSteps);
        float u1 = float(i + 1) / float(kNumSteps);
        float t0 = tStart + span * u0 * u0;
        float dt = span * (u1 * u1 - u0 * u0);
        float t = t0 + 0.5 * dt;
        vec3 p = camPos + rayDir * t;
        float r = length(p - planetCenter);
        float h = r - uAtmos.planetRadius;
        
        if (h < 0.0) break;
        
        // Density
        GE_SkyMedium medium = GE_SkyMediumAt(h);
        vec3 sigmaS_Ray = medium.scatterRayleigh;
        vec3 sigmaS_Mie = medium.scatterMie;
        vec3 sigmaE = medium.extinction;
        
        // Step Transmittance
        vec3 stepTrans = exp(-sigmaE * dt);

        // The sources' light reaching the sample, single and multiple scattering.
        vec3 upP = (p - planetCenter) / r;
        vec3 inScatter = vec3(0.0);
        if (sunActive)
            inScatter += SourceInScatter(rayDir, upP, r, h, sigmaS_Ray, sigmaS_Mie, sunDir, sunRadiance);
        if (moonActive)
            inScatter += SourceInScatter(rayDir, upP, r, h, sigmaS_Ray, sigmaS_Mie, moonDir, moonRadiance);

        // Hillaire 2020's energy-conserving step integral: the in-scatter source is held
        // constant over the step and integrated against the transmittance from the
        // step's start, integral_0^dt exp(-sigmaE s) ds = (1 - stepTrans) / sigmaE, then
        // the path transmittance advances. Weighting by the transmittance after the step
        // instead darkens long steps (17.7 km for an even 64-step horizon ray, blue optical depth
        // 0.63 on the first one).
        accumScattering += accumTransmittance * (inScatter - inScatter * stepTrans) / max(sigmaE, vec3(1e-9));
        accumTransmittance *= stepTrans;
    }

    // Absolute scene-linear, never pre-exposed (P = 1 by construction): the passes that sample
    // this LUT into scene colour apply the pre-exposure themselves.
    imageStore(oSkyViewLUT, pixel, vec4(accumScattering, 1.0));
}
