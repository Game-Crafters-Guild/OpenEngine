#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2DArray uploaded;
layout(set = 0, binding = 1, std430) writeonly buffer Output { uint pixels[]; };
layout(push_constant) uniform Parameters { uint mip; uint width; uint height; uint offset; } parameters;

void main()
{
    uvec3 position = gl_GlobalInvocationID;
    if (position.x >= parameters.width || position.y >= parameters.height)
        return;
    vec4 color = texelFetch(uploaded, ivec3(position), int(parameters.mip));
    uint index = parameters.offset + (position.z * parameters.height + position.y) * parameters.width + position.x;
    pixels[index] = packUnorm4x8(color);
}
