#version 450

#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_samplerless_texture_functions : require

// Deterministic camera-relative grass placement.
//
// ONE WORKGROUP PER CELL of a world-anchored lattice (grass_placement.glsl).
// terrain_grass_plan.comp has already decided, for every cell, whether it is visible, which terrain
// it stands on, how many slots it reserves, which LOD it draws with and WHERE those slots sit in
// the pool. This kernel reads that plan and fills the range: slot `s` lands at `Base + s`, always.
//
// No atomic decides an index or a membership here, so the placed set and its ORDER are a pure
// function of the inputs. A candidate the mask rejects still occupies its own slot, written as a
// zero-size blade whose triangles are degenerate and discarded before rasterization — paying a
// dead vertex rather than shifting every blade after it.
//
// A blade's position, yaw and scale are a pure function of (cellX, cellZ, slot, seed): nothing
// depends on the terrain's size, the camera's position, or the dispatch's extent, so grass is
// identical at 512 m and at 16 km, and a blade never moves when the camera does.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

#include "grass_placement.glsl"
#include "TerrainGrass/grass_clump.glsl"

