    {
      "id": "Physics.RayCastAll",
      "name": "RayCastAll",
      "cpp": "GameEngine::PhysicsECS::Script::RayCastAll",
      "header": "PhysicsECS/PhysicsScriptApi.h",
      "line": 79,
      "doc": "Casts a ray and writes every body it hits within maxDistance into hits, nearest first, each body once at its nearest hit. Returns the number of bodies the ray hits. When that is more than hits holds, the nearest ones that fit are written: call again with a larger buffer to get all of them. A buffer of length 0 asks the number only. 0 outside play mode. The direction need not be of length 1. Only bodies on a layer of layerMask are hit; triggers are hit unless ignoreTriggers is true.",
      "thread": "main",
      "context": "Physics::PhysicsWorld",
      "returns": {
        "kind": "Int32"
      },
      "params": [
        {
          "name": "origin",
          "kind": "Vec3"
        },
        {
          "name": "direction",
          "kind": "Vec3"
        },
        {
          "name": "hits",
          "kind": "Span",
          "element": {
            "kind": "Record",
            "type": "Physics.RayHit"
          },
          "out": true
        },
        {
          "name": "maxDistance",
          "kind": "Float",
          "default": "1000"
        },
        {
          "name": "layerMask",
          "kind": "UInt32",
          "default": "4294967295",
          "defaultConstant": "Physics.kAllLayers"
        },
        {
          "name": "ignoreTriggers",
          "kind": "Bool",
          "default": "false"
        }
      ]
    },
