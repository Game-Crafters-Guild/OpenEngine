        },
        {
          "name": "direction",
          "kind": "Vec3"
        },
        {
          "name": "hit",
          "kind": "Record",
          "type": "Physics.RayHit",
          "out": true
        },
        {
          "name": "maxDistance",
          "kind": "Float",
          "default": "1000"
        },
        {
          "name": "layerMask",
          "kind": "UInt32",
          "default": "4294967295",
