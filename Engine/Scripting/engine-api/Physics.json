    {
      "id": "Physics.BoxOverlap",
      "name": "BoxOverlap",
      "cpp": "GameEngine::PhysicsECS::Script::BoxOverlap",
      "header": "PhysicsECS/PhysicsScriptApi.h",
      "line": 90,
      "doc": "Writes the entity of every body that overlaps a box into bodies, in no fixed order. The box is centered at center, extends halfExtents from it along each of its axes (in meters, each above 0), and is turned by rotation. Returns the number of bodies in the box. When that is more than bodies holds, the ones that fit are written: call again with a larger buffer to get all of them. A buffer of length 0 asks the number only. 0 outside play mode. Only bodies on a layer of layerMask are found; triggers are found unless ignoreTriggers is true.",
      "thread": "main",
      "context": "Physics::PhysicsWorld",
      "returns": {
        "kind": "Int32"
      },
      "params": [
        {
          "name": "center",
          "kind": "Vec3"
        },
        {
          "name": "halfExtents",
          "kind": "Vec3"
        },
        {
          "name": "rotation",
          "kind": "Quat"
        },
        {
          "name": "bodies",
          "kind": "Span",
          "element": {
            "kind": "Entity"
          },
          "out": true
        },
        {
          "name": "layerMask",
          "kind": "UInt32",
          "default": "4294967295",
          "defaultConstant": "Physics.kAllLayers"
        },
        {
          "name": "ignoreTriggers",
          "kind": "Bool",
          "default": "false"
        }
      ]
    },
