#version 450

// Test-only probe for the night sky's shipped GLSL (SkyNightProbeTests). It calls the production
// functions of Includes/moon_disc.glsl and Includes/sky_composite.glsl and composes nothing itself.
//
// Mode 0, the moon disc: for the world-space sun and moon directions, invocation i of a count x count
// grid over the drawn disc (moon UV space) writes GE_MoonDiscRadiance on the real moon texture's tap
// (xyz) and the phase mask times the art's alpha (w). The two invocations after the grid write the
// disc's frame from GE_MoonDiscFrame (right, then up), so the test can place the lit side on the sky.
// Mode 1, the night glow: invocation i writes GE_ApplySkyGroundAndNight for a view direction at
// elevation 90 x i / (count - 1) degrees, on the open sky (no stylized ground).
// Mode 2, the sky under the disc and what it hides, a fixed table: slots 0 to 3 write the four
// GE_MoonRimDirection taps (xyz) and their angle from the moon (w); slots 4 to 6 write
// GE_MoonSkyUnderDisc over a direct sky of 0 and a rim sky of 1 for a hidden moon (cover 1, no
// transmittance), a full cover in clear air and a half cover in clear air (x); slot 7 writes
// GE_MoonHidesBehind for a unit falling star under a cover of 0.75 (x).

#include "Includes/moon_disc.glsl"
#include "Includes/sky_composite.glsl"

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform sampler2D uMoonTexture;
layout(set = 0, binding = 1) buffer ProbeOut { vec4 result[]; } uOut;

layout(push_constant) uniform ProbePC
{
    vec4 modeCountRadiusIlluminance; // x mode, y count, z drawn angular radius (rad), w illuminance
    vec4 trimNight;                  // x trim EV, y nightAmount
    vec4 sunDir;                     // world space, unit
    vec4 moonDir;                    // world space, unit
    vec4 skyColor;                   // mode 1: the LUT's sky under the glow
    vec4 nightSkyHorizonColor;       // mode 1: the sky settings' nightSkyHorizonColor
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint mode = uint(pc.modeCountRadiusIlluminance.x);
    uint count = uint(pc.modeCountRadiusIlluminance.y);
    float drawnRadius = pc.modeCountRadiusIlluminance.z;
    vec3 moonDir = normalize(pc.moonDir.xyz);
    vec3 discRight;
    vec3 discUp;
    GE_MoonDiscFrame(moonDir, discRight, discUp);

    if (mode == 0u)
    {
        uint samples = count * count;
        if (i == samples)
        {
            uOut.result[i] = vec4(discRight, 0.0);
            return;
        }
        if (i == samples + 1u)
        {
            uOut.result[i] = vec4(discUp, 0.0);
            return;
        }
        if (i > samples + 1u)
            return;
        vec2 cell = (vec2(float(i % count), float(i / count)) + 0.5) / float(count);
        vec2 p = cell * 2.0 - 1.0; // the disc's plane, in drawn radii: x along right, y down up
        vec2 moonUv = p * 0.5 + 0.5;
        vec4 albedo = textureLod(uMoonTexture, moonUv, 0.0);
        vec3 sunInDisc = GE_MoonSunInDiscFrame(normalize(pc.sunDir.xyz), moonDir, discRight, discUp);
        vec3 radiance = GE_MoonDiscRadiance(albedo, moonUv, length(p), sunInDisc,
                                            pc.modeCountRadiusIlluminance.w, pc.trimNight.x);
        uOut.result[i] = vec4(radiance, GE_MoonPhaseMask(moonUv, sunInDisc) * albedo.a);
        return;
    }

    if (i >= count)
        return;

    if (mode == 2u)
    {
        if (i < 4u)
        {
            vec3 rim = GE_MoonRimDirection(moonDir, discRight, discUp, drawnRadius, int(i));
            uOut.result[i] = vec4(rim, acos(clamp(dot(rim, moonDir), -1.0, 1.0)));
        }
        else if (i == 4u)
            uOut.result[i] = vec4(GE_MoonSkyUnderDisc(vec3(0.0), vec3(1.0), 1.0, vec3(0.0)), 0.0);
        else if (i == 5u)
            uOut.result[i] = vec4(GE_MoonSkyUnderDisc(vec3(0.0), vec3(1.0), 1.0, vec3(1.0)), 0.0);
        else if (i == 6u)
            uOut.result[i] = vec4(GE_MoonSkyUnderDisc(vec3(0.0), vec3(1.0), 0.5, vec3(1.0)), 0.0);
        else if (i == 7u)
            uOut.result[i] = vec4(GE_MoonHidesBehind(vec3(1.0), 0.75), 0.0);
        return;
    }

    float elevation = radians(90.0 * float(i) / float(max(count, 2u) - 1u));
    vec3 dirWS = vec3(cos(elevation), sin(elevation), 0.0);
    vec3 glow = GE_ApplySkyGroundAndNight(pc.skyColor.rgb, dirWS, sin(elevation), pc.trimNight.y, false,
                                          vec3(0.3), 1.0, vec3(0.0), 0.0, vec3(0.0), 1.0,
                                          pc.nightSkyHorizonColor.rgb);
    uOut.result[i] = vec4(glow, 0.0);
}
