<Project Sdk="Microsoft.NET.Sdk">
  <!-- The generated C# bindings against the real GameEngine.Native, in-process: the CTest entry
       ManagedBindingTests stages the engine's own GameEngine.Native and Engine beside this output,
       and the first call starts a standalone engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- An undocumented public member is an error (.editorconfig), except in the fixture mirrors. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scripting.Bindings\GameEngine.Scripting.Bindings.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The component mirrors the scanner generates from its fixture, compiled against the types the
         engine's mirrors use (ComponentMirrorFixtureTests). Their fields carry no documentation, which
         the .editorconfig beside them allows. -->
    <Compile Include="..\..\Tools\ComponentScanner\Tests\Fixtures\Components\Expected\CSharp\**\*.g.cs"
             LinkBase="ComponentMirrorFixture" />
  </ItemGroup>
</Project>
