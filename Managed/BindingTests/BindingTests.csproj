<Project Sdk="Microsoft.NET.Sdk">
  <!-- The generated C# bindings against the real GameEngine.Native, in-process: the CTest entry
       ManagedBindingTests stages the engine's own GameEngine.Native and Engine beside this output,
       and the first call starts a standalone engine. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Scripting.Bindings\GameEngine.Scripting.Bindings.csproj" />
  </ItemGroup>
</Project>
