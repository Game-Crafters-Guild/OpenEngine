<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameEngine.ECS.ABI</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameEngine.Scripting.Runtime" />
    <!-- EntityCommands queues a mirror's write as a script write (ComponentType<T>.IsEngineComponent). -->
    <InternalsVisibleTo Include="GameEngine.Scripting.ABI" />
    <!-- The generated component mirrors read ComponentType<T>.Default in their constructors;
         BindingTests compiles the scanner's fixture mirrors. -->
    <InternalsVisibleTo Include="GameEngine.Scripting.Bindings" />
    <InternalsVisibleTo Include="BindingTests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Common\NativeEngineLibrary.cs" Link="NativeEngineLibrary.cs" />
  </ItemGroup>
</Project>


